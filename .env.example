# ------------------------------------------------------------
# Local PostgreSQL container
# ------------------------------------------------------------
POSTGRES_USER=eventapp
POSTGRES_PASSWORD=eventapp_dev_password
POSTGRES_DB=event_management
POSTGRES_PORT=5432

# ------------------------------------------------------------
# Go API
# ------------------------------------------------------------
APP_PORT=8080

# Use a long development-only secret.
# AWS will inject the real value through Secrets Manager.
JWT_SECRET=local-development-jwt-secret-change-this-value-123456789

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
UPLOAD_URL_BASE=/uploads

# Used only when STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
S3_BUCKET=

# ------------------------------------------------------------
# Database connection pool
# ------------------------------------------------------------
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5